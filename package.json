{
  "name": "ch-context",
  "version": "1.0.0",
  "description": "Compact context stats, linked activity browser and file/command insights for CodexHost Web.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "ABC-xiaoxuan",
  "contributors": [
    "bowenliang123 (upstream dsh-context)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABC-xiaoxuan/ch-context.git"
  },
  "homepage": "https://github.com/ABC-xiaoxuan/ch-context",
  "bugs": {
    "url": "https://github.com/ABC-xiaoxuan/ch-context/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "icon": "icon.svg",
  "exports": {
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "README_en.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "codexhost",
    "context",
    "usage",
    "tokens",
    "dsh-plugin"
  ],
  "scripts": {
    "build": "npm run build:legacy && npm run build:native",
    "build:legacy": "node scripts/build-codexhost.mjs",
    "build:native": "node scripts/build-marketplace.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.codexhost.json",
    "test": "node --test tests/codexhost/*.test.ts",
    "test:browser": "npm run build && node scripts/test-codexhost-browser.mjs",
    "test:market": "node --test tests/market/*.test.mjs",
    "pack:market": "npm run build:native && npm run verify:market && node scripts/package-marketplace.mjs",
    "verify:market": "node scripts/verify-marketplace.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:package && npm run verify:market",
    "verify:package": "node scripts/verify-codexhost-package.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "chContext": {
    "host": "codexhost",
    "minimumTestedVersion": "0.25.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "^0.25.12",
    "fflate": "0.8.2",
    "marked": "16.4.2",
    "playwright-core": "^1.56.1",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  }
}
