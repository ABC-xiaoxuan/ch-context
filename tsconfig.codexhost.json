{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "src/codexhost/**/*.ts",
    "src/codexhost/**/*.tsx",
    "src/market/**/*.ts",
    "src/market/**/*.tsx",
    "tests/codexhost/**/*.ts"
  ]
}
